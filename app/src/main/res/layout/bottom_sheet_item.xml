<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/settingsSize_61dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/playlistImageV"
        style="@style/TrackImageViewStyle"
        android:layout_height="45dp"
        android:layout_width="45dp"
        android:src="@drawable/krest" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/albumTitle"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/TrackTitleTextViewStyle"
            android:textColor="@color/blacks"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/track_count"
                android:fontFamily="@font/ys_display_regular"
                android:layout_marginStart="@dimen/_8dp"
                style="@style/ArtistTimeTextViewStyle"
                android:textColor="@color/greyss"
                android:text="@string/_count" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/mediaFragment">

    <activity
        android:id="@+id/playerActivity"
        android:name="com.example.myplaylistmaker.player.ui.PlayerActivity"
        android:label="activity_player"
        tools:layout="@layout/activity_player" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.myplaylistmaker.media.ui.fragments.FavoritesFragment"
        android:label="fragment_favorites"
        tools:layout="@layout/fragment_favorites">
        <action
            android:id="@+id/action_favoritesFragment_to_playerActivity"
            app:destination="@id/playerActivity" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.myplaylistmaker.search.ui.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_playerActivity"
            app:destination="@id/playerActivity" />
    </fragment>
    <fragment
        android:id="@+id/playlistsFragment"
        android:name="com.example.myplaylistmaker.media.ui.fragments.PlaylistsFragment"
        android:label="fragment_playlists"
        tools:layout="@layout/fragment_playlists">
        <action
            android:id="@+id/action_playlistsFragment_to_newPlayListFragment"
            app:destination="@id/newPlayListFragment" />
        <action
            android:id="@+id/action_playlistsFragment_to_enterPlaylistFragment"
            app:destination="@id/enterPlaylistFragment" />
    </fragment>
    <fragment
        android:id="@+id/mediaFragment"
        android:name="com.example.myplaylistmaker.media.ui.fragments.MediaFragment"
        android:label="media_fragment"
        tools:layout="@layout/media_fragment">
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.myplaylistmaker.settings.ui.SettingsFragment"
        android:label="settings_fragment"
        tools:layout="@layout/settings_fragment" />
    <fragment
        android:id="@+id/newPlayListFragment"
        android:name="com.example.myplaylistmaker.media.ui.fragments.NewPlayFragment"
        android:label="new_playlist_fragment"
        tools:layout="@layout/fragment_new_play">
        <action
            android:id="@+id/action_newPlayListFragment_to_playerActivity"
            app:destination="@id/playerActivity" />
    </fragment>
    <fragment
        android:id="@+id/enterPlaylistFragment"
        android:name="com.example.myplaylistmaker.media.ui.fragments.EnterPlaylistFragment"
        android:label="enter_playlist_fragment"
        tools:layout="@layout/fragment_enter_playlist">
        <action
            android:id="@+id/action_enterPlaylistFragment_to_newPlayListFragment"
            app:destination="@id/newPlayListFragment" />
    </fragment>
</navigation>